# Frontend
# En Vercel puede omitirse: en producción la app usa /api/leads por defecto.
VITE_LEADS_BACKEND=api

# Opcional para desarrollo local sin `vercel dev`.
# Si defines VITE_LEADS_BACKEND=supabase, el navegador insertará directo en Supabase.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Vercel Serverless Function (/api/leads)
# Configurar estas variables solo en Vercel, sin prefijo VITE_.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_ADMIN_PIN=CAMBIA_ESTE_PIN
